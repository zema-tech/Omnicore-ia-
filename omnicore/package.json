{
  "name": "omnicore",
  "version": "0.1.0",
  "description": "Omnicore fusion core: OpenClaw (face) + Hermes (brain) + OpenCode (hands)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/index.ts",
    "fuse": "node --experimental-strip-types src/index.ts --fuse",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fuse:py": "python3 omnicore_py/cli.py --fuse",
    "fuse:sh": "bash scripts/omnicore.sh --fuse",
    "fuse:rs": "cargo run -q -p omnicore_rs --"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.8.2"
  }
}
