{
  "name": "omnicore",
  "version": "0.2.0",
  "description": "Omnicore — IA agente (memoria · codice · presenza · mondo · decide)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/index.ts",
    "agent": "node --experimental-strip-types src/index.ts --agent",
    "fuse": "node --experimental-strip-types src/index.ts --fuse",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fuse:py": "python3 omnicore_py/cli.py --fuse",
    "fuse:sh": "bash scripts/omnicore.sh --fuse",
    "fuse:rs": "cargo run -q --manifest-path omnicore_rs/Cargo.toml --",
    "omni": "node --experimental-strip-types omniling/ts/index.ts",
    "omni:py": "python3 omniling/py/cli.py",
    "serve": "python3 server.py"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.8.2"
  }
}
