# Omnicore env — copia in .env e compila. Tutte opzionali: i default bastano per localhost.
# DOVE: repo-root/.env se usi compose, oppure esportale nella shell / servizio.

# --- Hermes (brain) ---
# Directory del checkout hermes-agent (submodule vendors/hermes).
# Default: <repo>/vendors/hermes (risolto in automatico, non serve toccarlo
# salvo checkout in path custom o installazione via pip).
HERMES_DIR=
# Binario python (default: python3 dal PATH).
HERMES_PYTHON=python3
# Home di stato Hermes (conversazioni/canali). Default: ~/.hermes
# HERMES_HOME=

# --- OpenCode (hands) ---
# URL di `opencode serve`. Se non gira, fallback automatico su `opencode run` CLI.
OPENCODE_URL=http://127.0.0.1:4096
# Password server (solo se `opencode serve` è protetto). MAI committare il valore reale.
OPENCODE_SERVER_PASSWORD=

# --- OpenClaw (face) ---
# URL del gateway OpenClaw (default porta gateway 18789).
OPENCLAW_URL=http://127.0.0.1:18789
# Token operatore gateway (solo se richiesto). MAI committare il valore reale.
OPENCLAW_TOKEN=

# --- Rust (solo diagnostica path) ---
# Radice omnicore se l'eseguibile gira fuori albero (systemd/docker).
# OMNICORE_HOME=
