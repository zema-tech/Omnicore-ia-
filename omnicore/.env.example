# Omnicore env — copia in .env e compila. Tutte opzionali: i default bastano per localhost.
# DOVE: repo-root/.env se usi compose, oppure esportale nella shell / servizio.

# --- Hermes (brain) ---
# Directory del checkout hermes-agent (submodule vendors/hermes).
# Default: <repo>/vendors/hermes (risolto in automatico, non serve toccarlo
# salvo checkout in path custom o installazione via pip).
HERMES_DIR=
# Binario python (default: python3 dal PATH).
HERMES_PYTHON=python3
# Home di stato Hermes (conversazioni/canali). Default: ~/.hermes
# HERMES_HOME=

# --- OpenCode (hands) ---
# URL di `opencode serve`. Se non gira, fallback automatico su `opencode run` CLI.
OPENCODE_URL=http://127.0.0.1:4096
# Password server (solo se `opencode serve` è protetto). MAI committare il valore reale.
OPENCODE_SERVER_PASSWORD=

# --- OpenClaw (face) ---
# URL del gateway OpenClaw (default porta gateway 18789).
OPENCLAW_URL=http://127.0.0.1:18789
# Token operatore gateway (solo se richiesto). MAI committare il valore reale.
OPENCLAW_TOKEN=

# --- Telegram (backend reale: invio + lettura via Bot API) ---
# Crea il bot con @BotFather e incolla il token. MAI committare il valore reale.
# TELEGRAM_BOT_TOKEN=
# Solo test/locali: base alternativa (default https://api.telegram.org).
# TELEGRAM_API_BASE=
# Timeout chiamate Bot API in ms (poll usa timeout+10s).
# OMNICORE_TELEGRAM_TIMEOUT_MS=15000

# --- Discord (backend reale: invio REST + lettura Gateway WS) ---
# Bot token da https://discord.com/developers/applications (intents MESSAGE_CONTENT). MAI committare.
# DISCORD_BOT_TOKEN=
# Solo test/locali: base REST e gateway alternativi.
# DISCORD_API_BASE=
# DISCORD_GW_URL=

# --- Slack (backend reale: invio Web API + parser Events API) ---
# Bot token xoxb- da api.slack.com/apps (scope chat:write). MAI committare.
# SLACK_BOT_TOKEN=
# Solo test/locali.
# SLACK_API_BASE=

# --- Rust (solo diagnostica path) ---
# Radice omnicore se l'eseguibile gira fuori albero (systemd/docker).
# OMNICORE_HOME=

# --- Omnicore mind (vera IA: sintesi LLM, opzionale) ---
# Senza queste, Omnicore risponde con sintesi euristica offline (funziona sempre).
# Con queste, usa un LLM vero per la risposta unificata.
# Esempi baseUrl: https://openrouter.ai/api/v1 | http://127.0.0.1:11434/v1 (Ollama) | http://127.0.0.1:1234/v1 (LM Studio)
OMNICORE_LLM_PROVIDER=api
OMNICORE_LLM_BASE_URL=
OMNICORE_LLM_API_KEY=
OMNICORE_LLM_MODEL=omnicore-fusion
# Solo provider local (mai cloud):
OMNICORE_LLM_LOCAL_MODEL=llama3.1

# --- Budget LLM (tutti opzionali, 0 = illimitato) ---
# Token/giorno: oltre soglia fallback cheap o stop -> euristica.
# OMNICORE_BUDGET_TOKENS_DAY=100000
# Modello economico di fallback (stesso baseUrl).
# OMNICORE_LLM_CHEAP_MODEL=
# File tracking (default omnicore/data/llm_usage.jsonl).
# OMNICORE_USAGE_FILE=

# --- Embedding locali (memoria vettoriale, tutto opzionale) ---
# Modello Ollama per vettori (es. nomic-embed-text). Vuoto = solo BM25.
# OMNICORE_EMBED_MODEL=
# Timeout embedding in ms.
# OMNICORE_EMBED_TIMEOUT_MS=30000

# --- Decide a cascata (Tappa 3): regole locali -> Jev API -> CLM GPU ---
# Chiavi SOLO da env, mai nel json. Senza chiavi/GPU restano le regole locali.
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai
CLM_API_KEY=
# CLM_BASE_URL=http://127.0.0.1:8700
# OMNICORE_JEV_THRESHOLD=0.6
# OMNICORE_CLM_THRESHOLD=0.6

# --- Profili (Tappa 4): light | medium | alt. Stesso core, moduli diversi. ---
# OMNICORE_PROFILE=light

# --- Sicurezza (Tappa 6): Bearer obbligatorio, fail-closed senza token. ---
# Genera con: python3 -c "import secrets; print(secrets.token_hex(32))"
# OMNICORE_API_TOKEN=cambia-questo-valore
# Ollama nativo (usato anche senza baseUrl, se Ollama gira):
# OLLAMA_HOST=http://127.0.0.1:11434
